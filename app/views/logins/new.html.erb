<main class="account-page">
  <h1>Log in to bbl</h1>
  <% if flash[:alert] %><p role="alert"><%= flash[:alert] %></p><% end %>
  <%= form_with url: login_path do |form| %>
    <%= form.label :username %><%= form.text_field :username, required: true, autocomplete: "username", maxlength: 24 %>
    <%= form.label :password %><%= form.password_field :password, required: true, autocomplete: "current-password" %>
    <%= form.submit "Log in" %>
  <% end %>
  <p>New here? <%= link_to "Create an account", signup_path %></p>
</main>
