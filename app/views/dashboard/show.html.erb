<% content_for :title, "pose." %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="tracker" data-controller="theme wearable-navigation live-summary" data-theme="dark">
  <a class="skip-link" href="#today">Skip to today’s stats</a>
  <main class="dashboard visual-dashboard">
    <%= render "groups/header" %>
    <%= link_to wearable_path, class: "panel connect-wearable-card grain-panel", data: { wearable_navigation_target: "connectCard" } do %>
      <span>Connect your wearable →</span>
    <% end %>
    <% if @group %>
      <%= link_to group_path(@group), class: "panel competition-hero competition-summary", aria: { label: "This week's race — view team rankings" } do %>
        <p class="eyebrow">THIS WEEK'S RACE</p>
        <div class="competition-standing">
          <div class="standing-rank"><span class="sr-only">Rank </span><%= @entry.rank ? "##{@entry.rank}" : "—" %></div>
        </div>
        <span class="competition-summary-arrow" aria-hidden="true">→</span>
      <% end %>
    <% else %>
      <%= link_to groups_path, class: "panel competition-hero competition-invite" do %>
        <p class="eyebrow">THIS WEEK'S RACE</p>
        <span class="competition-invite-label">Join group →</span>
      <% end %>
    <% end %>
    <%= render "today_summary" %>
    <div class="weekly-card-link" data-live-summary-target="content" data-live-summary-key="weekly">
      <%= render "weekly" %>
      <%= link_to "View week details", details_path(period: "week"), class: "weekly-details-link" %>
    </div>
    <%= render "dashboard/posture_context" %>
  </main>
</div>
