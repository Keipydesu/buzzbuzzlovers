<% content_for :title, "bbl" %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<div class="tracker" data-controller="theme" data-theme="dark">
  <a class="skip-link" href="#today">Skip to today’s stats</a>
  <main class="dashboard visual-dashboard">
    <%= render "groups/header" %>
    <section class="panel competition-hero">
      <p class="eyebrow">THIS WEEK'S RACE</p>
      <% if @group %>
        <h1><%= @group.name %></h1>
        <div class="competition-standing"><div class="standing-rank"><%= @entry.rank ? "##{@entry.rank}" : "—" %><span>your rank</span></div><div class="standing-message"><p><%= @entry.ratio ? "#{number_with_precision(@entry.ratio.to_f * 100, precision: 2)}% slouch share" : "No recorded activity this week yet." %></p></div></div>
        <%= link_to "See leaderboard →", group_path(@group), class: "competition-primary" %>
      <% else %>
        <h1>Better together</h1>
      <% end %>
      <%= link_to "Your groups", groups_path, class: "group-link" %>
    </section>
    <%= render "today" %>
    <%= render "weekly" %>
    <section class="panel muse-entry"><h2>Desk setup &amp; habits</h2><%= link_to "Ask Muse →", coach_path, class: "group-link" %></section>
  </main>
</div>
