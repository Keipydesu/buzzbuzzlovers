<% content_for :title, "pose." %>
<% content_for :head do %><meta name="turbo-cache-control" content="no-cache"><% end %>
<% fixture_mode = Rails.env.test? && ENV["BBL_E2E"] == "1" && params[:ble_fixture] == "1" %>
<div class="tracker" data-controller="theme device wearable-navigation" data-theme="dark" data-device-account-value="<%= current_user.id %>"
  <% if fixture_mode %>data-device-fixture-value="true" data-device-fixture-device-value="<%= current_user.devices.order(:id).first&.id %>" data-device-observed-at-value="<%= Time.current.iso8601 %>"<% end %>>
  <a class="skip-link" href="#wearable-heading">Skip to wearable</a>
  <main class="dashboard wearable-page">
    <%= render "groups/header" %>
    <section class="panel wearable-panel grain-panel" data-device-target="setupPanel" aria-labelledby="wearable-heading">
      <h1 id="wearable-heading">Wearable</h1>
      <% if fixture_mode %><p class="fixture-banner">SIMULATED WEARABLE · isolated test data</p><% end %>
      <div class="sr-only" data-device-target="progress" role="progressbar" aria-label="Wearable setup" aria-valuemin="0" aria-valuemax="2" aria-valuenow="0" aria-valuetext="Connect your wearable"></div>
      <ol class="pairing-stages" aria-label="Setup steps">
        <li data-device-target="stage" aria-current="step"><span>1</span>Connect</li>
        <li data-device-target="stage"><span>2</span>Calibrate</li>
        <li data-device-target="stage"><span>✓</span>Ready</li>
      </ol>
      <p class="connection-notice" data-device-target="connection" role="status">Checking Bluetooth support…</p>
      <div class="wearable-step" data-device-target="connectStep">
        <h2 class="sr-only">Connect your wearable</h2>
        <p>Wearable on and nearby?</p>
        <div class="wearable-actions"><button type="button" class="competition-primary" data-device-target="connectButton" data-action="device#connectWearable">Connect wearable</button></div>
      </div>
      <div class="wearable-step" data-device-target="calibrateStep" hidden>
        <h2 class="sr-only">Calibrate your posture</h2>
        <p data-device-target="calibrationHint">Sit upright. Press <strong>BOOT</strong>. Hold still.</p>
      </div>
      <h2 class="pairing-ready" data-device-target="readyStep" hidden>You're ready.</h2>
      <div data-device-target="trackingStep" hidden>
        <p data-device-target="posture" class="wearable-posture" role="status">No live reading</p>
        <p class="chart-caption">Keep the app open while tracking.</p>
        <%= link_to "Go to dashboard →", root_path, class: "competition-primary wearable-dashboard-button", data: { device_target: "dashboardButton" }, hidden: true %>
      </div>
      <p data-device-target="saving" role="status" hidden>No pending saves.</p>
      <div class="wearable-actions">
        <button type="button" class="competition-primary" data-device-target="calibrateButton" data-action="device#calibrate" hidden disabled>Calibrate</button>
        <button type="button" class="group-link" data-device-target="disconnectButton" data-action="device#disconnectWearable" disabled hidden>Disconnect</button>
        <button type="button" class="group-link" data-device-target="retryButton" data-action="device#retrySaving" hidden>Retry saving</button>
      </div>
      <details class="wearable-help">
        <summary>Device details</summary>
        <p data-device-target="identity" class="wearable-identity">No wearable selected</p>
        <p data-device-target="details"></p>
      </details>
    </section>
  </main>
</div>
