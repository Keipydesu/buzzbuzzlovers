<% content_for :integrated_account_nav, "true" %>
<header class="topbar compact-header">
  <%= link_to "bbl.", root_path, class: "brand" %>
  <div class="compact-header-actions">
    <% unless current_page?(wearable_path) %><%= link_to "Wearable →", wearable_path, class: "header-wearable" %><% end %>
    <button type="button" class="theme-button" data-icon-only="true" data-theme-target="button" data-action="theme#toggle" aria-label="Switch to light mode">☀</button>
    <nav class="account-menu" aria-label="Account">
      <details>
        <summary aria-label="Account menu">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M4 21v-2a8 8 0 0 1 16 0v2"/></svg>
          <span class="sr-only"><%= current_user.username %></span>
        </summary>
        <div class="account-menu-panel">
          <span><%= current_user.username %></span>
          <%= button_to "Log out", logout_path, method: :delete %>
        </div>
      </details>
    </nav>
  </div>
</header>
<% unless current_page?(root_path) %><%= link_to "← Your tracking", root_path, class: "back-link" %><% end %>
