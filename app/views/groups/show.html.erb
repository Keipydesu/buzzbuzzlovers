<% content_for :title, "#{@group.name} · pose." %>
<div class="tracker" data-controller="theme wearable-navigation" data-theme="dark">
  <main class="dashboard groups-page">
    <%= render "groups/header" %>
    <div class="group-heading"><p class="eyebrow">BETTER HABITS, TOGETHER</p><h1><%= @group.name %></h1><p><%= pluralize(@competition.entries.size, "member") %></p></div>
    <section class="panel leaderboard" aria-labelledby="leaderboard-title">
      <h2 id="leaderboard-title">This week's rankings</h2>
      <p class="chart-caption"><%= @competition.week_start.strftime("%b %-d") %>–<%= @competition.week_end.strftime("%b %-d, %Y") %></p>
      <p class="ranking-description">Lowest slouch share leads. Rankings update when you refresh.</p>
      <ol class="ranking-list">
        <% @competition.entries.each do |entry| %>
          <li class="ranking-row <%= "ranking-you" if entry.user == current_user %>">
            <span class="rank-number"><%= entry.rank || "—" %></span>
            <div class="member-info"><h3><%= entry.user.username %><%= " (you)" if entry.user == current_user %></h3><p><%= number_with_precision(entry.tracked_seconds / 60.0, precision: 1) %> min recorded</p></div>
            <span class="member-score"><%= entry.ratio ? "#{number_with_precision(entry.ratio.to_f * 100, precision: 2)}%" : "Unranked" %></span>
          </li>
        <% end %>
      </ol>
      <details class="competition-rules"><summary>How rankings work</summary>
        <p>Total slouch time divided by total tracked time; lower is better. Equal scores share rank. No minimum recording time. No recorded time means unranked.</p>
        <p>Monday–Sunday in <%= @competition.timezone %>. Sessions count in the week first seen, even when they span a boundary. Incomplete sessions count their saved totals. Late uploads can change results; weeks are not locked.</p>
        <p>Joining includes your recorded activity for the whole week. We trust friends to wear their trackers. This compares recorded habits, not medical health.</p>
      </details>
    </section>
    <section class="panel create-group">
      <h2>Most improved</h2>
      <% if @competition.most_improved.any? %>
        <div class="improvement-highlight">
          <strong class="improvement-name"><%= @competition.most_improved.map { |entry| entry.user.username }.join(", ") %></strong>
          <div class="improvement-result">
            <span class="improvement-badge">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 6 7 7 4-4 7 9M15 18h6v-6" /></svg>
              <%= number_with_precision(@competition.most_improved.first.improvement.to_f, precision: 2, strip_insignificant_zeros: true) %> pts
            </span>
            <span class="improvement-caption">less slouching</span>
          </div>
        </div>
      <% else %><p>No improvement yet.</p><% end %>
    </section>
    <section class="panel create-group">
      <h2>Invite your friends</h2>
      <p>Send this link or code. Anyone with it can join.</p>
      <p class="invite-code"><strong><%= @group.group_invitation.code %></strong></p>
      <p class="invite-link"><%= link_to group_invitation_url(code: @group.group_invitation.code), group_invitation_path(code: @group.group_invitation.code) %></p>
    </section>
    <div class="competition-actions"><%= link_to "All groups", groups_path, class: "group-link" %><%= button_to "Leave group", leave_group_path(@group), method: :delete, class: "group-create-button" %></div>
  </main>
</div>
