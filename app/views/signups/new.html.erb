<% content_for :title, "Sign up · bbl" %>
<div class="tracker" data-controller="theme" data-theme="dark">
  <main class="auth-page">
    <div class="panel auth-card">
      <div class="auth-card-top">
        <%= link_to "bbl.", root_path, class: "brand auth-brand" %>
        <button type="button" class="theme-button" data-theme-target="button" data-action="theme#toggle" aria-label="Switch to light mode">☀ Light mode</button>
      </div>
      <h1>Create your account</h1>
      <p class="auth-subtitle">Track your posture and join a friend group's weekly competition.</p>
      <% if @user.errors.any? %><p role="alert" class="auth-alert"><%= @user.errors.full_messages.to_sentence %></p><% end %>
      <%= form_with model: @user, url: signup_path, class: "auth-form" do |form| %>
        <div class="field">
          <%= form.label :username %>
          <%= form.text_field :username, required: true, autocomplete: "username", minlength: 3, maxlength: 24, "aria-describedby": "username-hint" %>
          <p class="field-hint" id="username-hint">3–24 letters, numbers, or underscores.</p>
        </div>
        <div class="field">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 12, "aria-describedby": "password-hint" %>
          <p class="field-hint" id="password-hint">Use at least 12 characters.</p>
        </div>
        <div class="field">
          <%= form.label :password_confirmation, "Confirm password" %>
          <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %>
        </div>
        <%= form.submit "Create account", class: "auth-submit" %>
      <% end %>
      <p class="auth-switch">Already registered? <%= link_to "Log in", login_path %></p>
    </div>
  </main>
</div>
