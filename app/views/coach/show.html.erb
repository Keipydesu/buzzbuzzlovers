<% content_for :title, "Ask Muse · pose." %>
<div class="tracker" data-controller="theme wearable-navigation" data-theme="dark">
  <main class="dashboard coach-page">
    <%= render "groups/header" %>
    <div class="coach-heading"><h1>Ask Muse</h1><p>Desk setup &amp; habits</p></div>
    <section class="muse-conversation" aria-label="Ergonomics help">
      <% if @error %><p class="coach-error" role="alert"><%= @error %></p><% end %>
      <% if @history.present? %>
        <div class="muse-thread">
          <% @history.each do |turn| %>
            <div class="muse-turn muse-turn-<%= turn[:role] %>">
              <h2><%= turn[:role] == "assistant" ? "Muse" : "You" %></h2>
              <%= simple_format(turn[:content]) %>
            </div>
          <% end %>
        </div>
      <% end %>
      <%= form_with url: coach_path, method: :post, data: { turbo: false } do |form| %>
        <%= form.label :question, @history.present? ? "Continue the conversation" : "What would you like to work on?", class: ("sr-only" unless @history.present?) %>
        <%= form.text_area :question, value: @question, required: true, maxlength: 2000, rows: 4, placeholder: "How can I improve my setup?" %>
        <p class="coach-sharing">Your question, this conversation, and a short summary of your own tracked totals (today and the last 7 days) are sent to Meta Muse Spark. Sessions are grouped by first-seen date, include saved partial sessions, and cannot split activity across midnight. Your group data, images, and raw sensor data are not included.</p>
        <% unless Muse::Coach.configured? %><p class="coach-availability">Muse isn't connected yet.</p><% end %>
        <%= form.button class: "group-create-button muse-submit", disabled: !Muse::Coach.configured?, data: { disable_with: "Asking Muse…" } do %>Ask Muse <span aria-hidden="true">→</span><% end %>
      <% end %>
      <% if @history.present? %>
        <%= button_to "Start a new conversation", coach_path, method: :delete, class: "coach-reset-button", form: { data: { turbo: false } } %>
      <% end %>
    </section>
    <p class="coach-footnote">General ergonomics guidance, not a medical assessment.</p>
  </main>
</div>
