<% live = Muse::Coach.configured? && current_user.present? %>
<section class="panel muse-chat" id="muse-chat" aria-label="Chat with Muse"
  data-controller="muse-chat" data-muse-chat-live-value="<%= live %>" data-muse-chat-url-value="<%= coach_path %>">
  <div class="muse-chat-top">
    <div class="muse-chat-heading"><span class="muse-orb" aria-hidden="true">✦</span><div><h2>Ask Muse</h2><p class="muse-subtitle">Small adjustments. Better habits.</p></div></div>
    <button type="button" class="theme-button" data-action="muse-chat#reset" data-muse-chat-target="reset">New chat</button>
  </div>
  <p class="muse-mode"><span class="status-dot" aria-hidden="true"></span> <%= live ? "Live Muse · recent messages provide context" : "Demo · scripted replies, no AI connection" %></p>
  <div class="muse-thread" role="log" aria-live="polite" aria-relevant="additions" aria-label="Conversation" data-muse-chat-target="thread">
    <article data-muse-greeting class="muse-bubble"><span class="muse-speaker">Muse<%= " demo" unless live %></span><p>What would you like to work on? Tell me about your posture or desk setup.</p></article>
    <% if current_user %>
      <% Muse::Conversation.for(current_user.id).each do |turn| %>
        <article class="muse-bubble <%= "muse-bubble-user" if turn[:role] == "user" %>"><span class="muse-speaker"><%= turn[:role] == "user" ? "You" : "Muse" %></span><p><%= turn[:content] %></p></article>
      <% end %>
    <% end %>
  </div>
  <div class="muse-typing" data-muse-chat-target="typing" hidden><span aria-hidden="true"><i></i><i></i><i></i></span><span role="status"><%= live ? "Muse is thinking…" : "Preparing a demo reply…" %></span></div>
  <div class="muse-prompts" data-muse-chat-target="prompts">
    <% if live %>
      <button type="button" data-action="muse-chat#analyze">Analyze my posture</button>
    <% end %>
    <button type="button" data-action="muse-chat#suggest">Why do I keep slouching?</button>
    <button type="button" data-action="muse-chat#suggest">Help with my laptop setup</button>
    <button type="button" data-action="muse-chat#suggest">Build a movement habit</button>
  </div>
  <p class="coach-error" role="alert" data-muse-chat-target="error" hidden></p>
  <form class="muse-composer" data-action="submit->muse-chat#send">
    <label for="muse-message" class="sr-only">Your message to Muse</label>
    <textarea id="muse-message" data-muse-chat-target="input" data-action="keydown->muse-chat#keydown" placeholder="Message Muse…" rows="1" maxlength="2000" required></textarea>
    <button type="submit" class="competition-primary" data-muse-chat-target="send">Send <span aria-hidden="true">↑</span></button>
  </form>
  <details class="muse-details">
    <summary><%= live ? "How your conversation is shared" : "About this demo" %></summary>
    <p class="coach-sharing"><%= live ? "Your message, recent conversation, and your own tracked totals for today and the last seven days are shared with Meta Muse Spark. Analysis also shares your slouch share of recorded device time and how many dates have tracked time; totals may include overlapping devices. Saved sessions are grouped by first-seen date and cannot split activity across midnight. Group data, images, and raw sensor data are not shared." : "Demo messages stay in this page. Replies use preset guidance; they are not generated by Muse Spark." %> <%= live ? "Live context stays in local server memory for up to 30 minutes of inactivity. New chat clears it. Follow-ups are user-initiated; no reminders are scheduled." : "Demo conversation clears when you leave or reload." %></p>
  </details>
  <p class="coach-footnote">General posture-awareness guidance<span class="muse-keyboard-hint"> · Enter to send, Shift+Enter for a new line</span>.</p>
  <noscript><p>Enable JavaScript to use the continuing chat.</p></noscript>
</section>
