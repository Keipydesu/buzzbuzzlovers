# Copy to .env (already gitignored) and fill in real values. Never commit .env.
# Muse chat: paste your Meta Model API key here, restart Rails, and sign in.
# The app loads .env automatically in development unless SKIP_DOTENV=1.
META_MUSE_API_KEY=
# Optional model override; leave unset to use muse-spark-1.3.
# META_MUSE_MODEL=muse-spark-1.3
#
# Tiger Cloud (TimescaleDB) connection string for the posture_snapshots hypertable
# migration and PostureSnapshot model. See docs/data-storage.md and
# docs/decisions/003-online-storage-with-tiger-data.md.
#
# This is NOT applied automatically to normal `bin/rails` commands (server, test,
# db:migrate) — those still use the local PostgreSQL config in config/database.yml
# by default, so a local dev loop can never silently hit hosted data. To run the
# hypertable migration (or anything else) against Tiger Cloud, opt in explicitly:
#
#   DATABASE_URL="$TIGER_DATABASE_URL" bin/rails db:migrate
#
# Paste the PostgreSQL connection string from Tiger's database Connect screen.
# Format: postgres://<user>:<password>@<host>:<port>/<database>?sslmode=require
# This is NOT a Tiger REST API access key or secret key.
TIGER_DATABASE_URL=
# Optional: if Tiger gives you a separate DATABASE PASSWORD, put it here.
# bin/tiger-storage uses this instead of the password embedded in the URL.
# Ordinary Rails DATABASE_URL connections still need a complete URL.
TIGER_DATABASE_PASSWORD=
# Trusted Tiger CA certificate path for bin/tiger-storage (defaults to system CAs).
# Download this from your authenticated Tiger console; do not use an unverified
# certificate obtained from the failing database connection.
# Example value: /absolute/path/to/tiger-ca.pem (a file path, not a password).
TIGER_SSLROOTCERT=
